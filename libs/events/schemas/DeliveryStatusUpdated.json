        "order_id",
        "customer_id",
        "rider_id",
        "rider_user_id",
        "from_status",
        "to_status"
      ],
      "title": "DeliveryStatusUpdatedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregate_id": {
      "title": "Aggregate Id",
      "type": "string"
    },
