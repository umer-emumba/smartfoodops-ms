{
  "$defs": {
    "DeliveryStatusUpdatedPayload": {
      "additionalProperties": false,
      "description": "`rider_id`/`rider_user_id` are the rider holding the delivery after the\nchange (None once released). `customer_id` is None only on a cancelled\nplaceholder delivery. `from_status` is None when the delivery is created.\n\n`released_rider_user_id`: the rider who just lost it \u2014 their offer was\ndeclined or expired, or they dropped out \u2014 so their app can be told\n(rider_user_id is already None by then). `pickup_eta`/`dropoff_eta` are\nthe delivery's current estimates (None until computed, and after a\nrelease).",
      "properties": {
        "customer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Customer Id"
        },
        "delivery_id": {
          "title": "Delivery Id",
          "type": "string"
        },
        "dropoff_eta": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dropoff Eta"
        },
        "from_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "From Status"
        },
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "pickup_eta": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pickup Eta"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "released_rider_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Released Rider User Id"
        },
        "rider_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rider Id"
        },
        "rider_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
