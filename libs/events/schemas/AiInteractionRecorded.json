{
  "$defs": {
    "AiInteractionRecordedPayload": {
      "additionalProperties": false,
      "description": "One AI interaction (week5-plan step 6): a chat turn, an order\nexplanation or a content generation. Metadata only \u2014 never the\ncustomer's words or the answer (B5-D8).",
      "properties": {
        "conversation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        },
        "cost_usd": {
          "default": "0",
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Cost Usd",
          "type": "string"
        },
        "first_output_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Output Ms"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "intent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Intent"
        },
        "interaction_id": {
          "title": "Interaction Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "restaurant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Restaurant Id"
        },
        "shown_item_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Shown Item Ids",
          "type": "array"
        },
        "shown_restaurant_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Shown Restaurant Ids",
          "type": "array"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "user_id": {
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "interaction_id",
        "user_id",
        "kind",
        "intent",
        "status"
      ],
      "title": "AiInteractionRecordedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregate_id": {
      "title": "Aggregate Id",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "AiInteractionRecorded",
      "title": "Event Type",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/AiInteractionRecordedPayload"
    }
  },
  "required": [
    "event_id",
    "aggregate_id",
    "occurred_at",
    "event_type",
    "payload"
  ],
  "title": "AiInteractionRecorded",
  "type": "object"
}
