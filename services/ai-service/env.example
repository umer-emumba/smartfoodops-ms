SERVICE_NAME=ai-service
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@ai-db:5432/ai_db
REDIS_URL=redis://redis:6379/0

# Public keys that verify access tokens come from user-service's JWKS (default):
# JWT_JWKS_URL=http://user-service:8000/.well-known/jwks.json
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Vector store (docs/week4-plan.md B4-D2).
QDRANT_URL=http://qdrant:6333

# The indexer's Kafka consumer (step 3). embedded: runs inside the API
# process (development). standalone: `python -m app.consumer` as its own
# process from the same image (production).
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_CONSUMER_MODE=embedded
# Embedding models (B4-D3) are set by the image (Dockerfile ARGs), as is
# their cache directory.

# Claude, used from Week 5. Put your own key in .env only — never in this
# file or in git.
ANTHROPIC_API_KEY=
