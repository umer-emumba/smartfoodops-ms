SERVICE_NAME=user-service
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@user-db:5432/user_db
REDIS_URL=redis://redis:6379/0

# Signs access tokens (Ed25519). Mounted by docker compose from secrets/ — create it
# with `uv run python scripts/gen_jwt_key.py`. Only user-service gets this key.
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
# Next/previous public keys during a rotation (empty otherwise; same script).
JWT_ADDITIONAL_PUBLIC_KEYS_FILE=/run/secrets/jwt_additional_public_keys
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

ADMIN_BOOTSTRAP_SECRET=dev-bootstrap-secret-change-me
