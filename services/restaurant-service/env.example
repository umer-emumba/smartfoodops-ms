SERVICE_NAME=restaurant-service
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@restaurant-db:5432/restaurant_db
REDIS_URL=redis://redis:6379/0

# Public keys that verify access tokens come from user-service's JWKS (default):
# JWT_JWKS_URL=http://user-service:8000/.well-known/jwks.json
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Temporal (docs/week2-plan.md D2). embedded: the worker runs inside this
# service's API process (development). standalone: run `python -m app.worker`
# as its own process from the same image (production).
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_WORKER_MODE=embedded
