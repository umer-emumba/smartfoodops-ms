SERVICE_NAME=order-service
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@order-db:5432/order_db
REDIS_URL=redis://redis:6379/0

JWT_SECRET=dev-only-change-me-must-be-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

RESTAURANT_SERVICE_URL=http://restaurant-service:8000

# Temporal (docs/week2-plan.md D2). embedded: the worker runs inside this
# service's API process (development). standalone: run `python -m app.worker`
# as its own process from the same image (production).
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_WORKER_MODE=embedded
