SERVICE_NAME=tracking-service
ENVIRONMENT=local
LOG_LEVEL=INFO

REDIS_URL=redis://redis:6379/0

# Must match the other services' — tokens are issued by user-service.
# Public keys that verify access tokens come from user-service's JWKS (default):
# JWT_JWKS_URL=http://user-service:8000/.well-known/jwks.json

# Fallbacks when a Redis state key is missing (e.g. after a Redis restart).
ORDER_SERVICE_URL=http://order-service:8000
RESTAURANT_SERVICE_URL=http://restaurant-service:8000

HEARTBEAT_SECONDS=15
