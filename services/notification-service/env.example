SERVICE_NAME=notification-service
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@notification-db:5432/notification_db
REDIS_URL=redis://redis:6379/0

# Public keys that verify access tokens come from user-service's JWKS (default):
# JWT_JWKS_URL=http://user-service:8000/.well-known/jwks.json
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Kafka consumer (docs/week3-plan.md W3-D6). embedded: runs inside the API
# process (development). standalone: run `python -m app.consumer` as its own
# process from the same image (production). CELERY_BROKER_URL is set by
# docker-compose.yml.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_CONSUMER_MODE=embedded

# Sending (notification-worker, W3-D7). Email/SMS are simulated; this share
# of sends fails so retries are exercised.
NOTIFY_FAKE_FAILURE_RATE=0.1
NOTIFY_MAX_ATTEMPTS=5
