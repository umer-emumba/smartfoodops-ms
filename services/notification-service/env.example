SERVICE_NAME=notification-service
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@notification-db:5432/notification_db
REDIS_URL=redis://redis:6379/0

JWT_SECRET=dev-only-change-me-must-be-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
