SERVICE_NAME=analytics-service
ENVIRONMENT=local
LOG_LEVEL=INFO

# Must match the other services' — tokens are issued by user-service.
# Public keys that verify access tokens come from user-service's JWKS (default):
# JWT_JWKS_URL=http://user-service:8000/.well-known/jwks.json

# Read model: order/rider facts built from events (docs/week3-plan.md W3-D9).
MONGO_URL=mongodb://mongo:27017
MONGO_DB=analytics
# Peak hours are reported in this timezone's hours of the day.
ANALYTICS_TIMEZONE=Asia/Karachi

# Kafka consumer (W3-D6). embedded: inside the API process (development);
# standalone: `python -m app.consumer` from the same image (production).
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_CONSUMER_MODE=embedded
