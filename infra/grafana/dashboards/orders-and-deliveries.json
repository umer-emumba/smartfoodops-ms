      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(restaurant_responses_total{response=\"accepted\"}[$__range])) / sum(increase(restaurant_responses_total[$__range]))",
